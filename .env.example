# =============================================================================
# Night Audit Manager Pro - Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# =============================================================================

# --- Supabase (public, safe to expose in the frontend) ---
# The anon key is a PUBLIC key protected by Row Level Security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# --- App defaults ---
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_CURRENCY=MAD

# --- Offline mode ---
# When true the app runs fully on local IndexedDB with seeded demo data
# (no Supabase connection required). Great for local evaluation.
VITE_OFFLINE_DEMO=true

# =============================================================================
# SERVER-SIDE ONLY - these must live in Supabase Edge Function secrets,
# NEVER in this frontend .env and NEVER in client code.
#   SUPABASE_SERVICE_ROLE_KEY=...
#   SUPABASE_DB_URL=...
# Set them with: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# =============================================================================
